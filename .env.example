# Settings the site needs. Copy the names into the Vercel project's
# Environment Variables screen and fill in real values.
# Never commit real values — this file lists names only.
#
# --- Free-look enquiry form (needed for the form on /get-started to deliver) ---
# Without these the form still works, but the send fails and the visitor is
# offered their own email app as a fallback. Set them in Vercel for production.
#
# Resend (resend.com) → API keys. Free tier covers far more than this site sends.
RESEND_API_KEY=
# Where enquiries land. Defaults to thomas@kingdom-sites.com if unset.
LEAD_TO_EMAIL=
# Who they appear to come from. Must be a domain verified in Resend — until
# kingdom-sites.com is verified there, leave blank and Resend's own sending
# address is used. Format: Kingdom Sites <hello@kingdom-sites.com>
LEAD_FROM_EMAIL=
# Optional second destination for each enquiry — a Zapier/Make hook, a
# spreadsheet, a CRM. Leave blank if not used.
LEAD_WEBHOOK_URL=

# --- Calendly (AI consultation on /ai-tooling) ---
# Public event URL. Invoiced after — do not enable Calendly payments.
NEXT_PUBLIC_CALENDLY_AI_URL=

# --- Google Analytics 4 (optional but recommended in production) ---
# Analytics → Admin → Data streams → Web → Measurement ID (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Error reporting (optional; the site runs fine without all of these) ---
# Sentry project settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only used while building, to upload debug files. Builds succeed without it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# --- Kingdom Sites Sign (/sign) ---
# Admin login for creating and sending documents.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional dedicated session HMAC secret. If unset, derived from ADMIN_PASSWORD.
SIGN_SESSION_SECRET=
# Optional From: for magic links / completed PDFs. Falls back to LEAD_FROM_EMAIL,
# then Resend onboarding address. Must be a verified domain in Resend for production.
SIGN_FROM_EMAIL=
# Public site origin used inside magic-link emails. Defaults to VERCEL_URL or localhost.
SIGN_APP_URL=https://kingdom-sites.com
# Vercel Blob (required on Vercel so PDFs persist across serverless invocations).
# Locally, files are stored under .data/sign/ when this is unset.
BLOB_READ_WRITE_TOKEN=
